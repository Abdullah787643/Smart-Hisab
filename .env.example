# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# JWT_SECRET: Secret key for signing session tokens (JWT)
JWT_SECRET="your-super-secret-jwt-key-change-in-production"

# DATABASE_URL: Managed Cloud PostgreSQL connection string (Neon, Supabase, Google Cloud SQL, etc.)
# Format: postgresql://username:password@hostname:5432/dbname?sslmode=require
DATABASE_URL="postgresql://user:password@cloud-postgres-host:5432/smarthisab?sslmode=require"
